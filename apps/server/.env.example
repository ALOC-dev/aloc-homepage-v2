PORT=4000
NODE_ENV=development

# API 경로 프리픽스 (예: /api). 비워두면 /auth/login 처럼 루트에 마운트
API_PREFIX=

# DB: MySQL 8 (apps/server/docker-compose.yml 기본값과 맞춤). 로컬은 root 사용 — prisma migrate dev가 shadow DB를 만들 권한이 필요함
DATABASE_URL=mysql://root:aloc@localhost:3307/aloc

# JWT (access token). 시크릿은 32자 이상 랜덤 값: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# refresh token은 DB에 해시로 저장하는 랜덤 문자열 (JWT 아님)
REFRESH_TOKEN_EXPIRES_DAYS=14

# CORS (프론트 주소, 콤마로 여러 개). localhost:4000 은 Swagger(/docs)에서 로그인 테스트용
CORS_ORIGIN=http://localhost:5173,http://localhost:4000

# 파일 업로드
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# 시드용 첫 관리자 계정 (pnpm --filter server db:seed)
SEED_ADMIN_LOGIN_ID=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# 테스트 전용 DB (pnpm --filter server test 가 이 DB를 비움)
TEST_DATABASE_URL=mysql://root:aloc@localhost:3307/aloc_test