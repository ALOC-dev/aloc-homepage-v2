// ALOC Homepage v2 — 데이터 모델
// project.md 10절 초안을 기반으로 작성. 필드는 팀 논의 후 조정하세요.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

// Prisma 7: 접속 URL은 prisma.config.ts, 런타임 연결은 src/db/prisma.ts (MariaDB adapter)
datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  ONGOING
  ENDED
}

enum PresentationType {
  MIDTERM
  FINAL
}

// ───────────────────────── 유저 / 인증 ─────────────────────────

model User {
  id                 Int       @id @default(autoincrement())
  /// 한글 아이디 (예: "5기 김정묵"). trim + 공백 정리 + NFC 정규화 후 저장
  loginId            String    @unique
  passwordHash       String
  role               Role      @default(USER)
  mustChangePassword Boolean   @default(true)
  generation         Int?
  name               String
  /// 자기소개. 이메일은 별도 필드 없이 본인이 원하면 여기에 적음
  bio                String    @default("") @db.VarChar(1000)
  photoFileId        Int?      @unique
  photoFile          File?     @relation("UserPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  /// 탈퇴 시각 (soft delete)
  deletedAt          DateTime?

  fields         UserField[]
  refreshTokens  RefreshToken[]
  projectMembers ProjectMember[]
  projects       Project[]       @relation("ProjectCreator")
  archives       Archive[]
  albums         Album[]
  photos         Photo[]
  materials      Material[]
  files          File[]          @relation("FileUploader")
  links          Link[]
}

model Field {
  id    Int         @id @default(autoincrement())
  name  String      @unique
  users UserField[]
}

model UserField {
  userId  Int
  fieldId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  field   Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([userId, fieldId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256(refreshToken). 원문은 저장하지 않음
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ───────────────────────── 프로젝트 ─────────────────────────

model Project {
  id          Int           @id @default(autoincrement())
  title       String
  description String        @db.Text
  status      ProjectStatus @default(ONGOING)
  startedAt   DateTime?
  endedAt     DateTime?
  createdById Int
  createdBy   User          @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members       ProjectMember[]
  repositories  ProjectRepo[]
  presentations Presentation[]

  @@index([status])
}

model ProjectMember {
  projectId Int
  userId    Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
}

model ProjectRepo {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String   @db.VarChar(2000)
  name      String?
  createdAt DateTime @default(now())
}

model Presentation {
  id        Int              @id @default(autoincrement())
  projectId Int
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      PresentationType
  fileId    Int              @unique
  file      File             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
}

// ───────────────────────── 아카이브 ─────────────────────────

model ArchiveCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  archives Archive[]
}

model Archive {
  id          Int             @id @default(autoincrement())
  categoryId  Int
  category    ArchiveCategory @relation(fields: [categoryId], references: [id])
  title       String
  content     String          @db.Text
  createdById Int
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  files File[]
  links Link[]

  @@index([categoryId])
}

// ───────────────────────── 사진 ─────────────────────────

model Album {
  id          Int       @id @default(autoincrement())
  title       String
  description String    @db.Text
  takenAt     DateTime?
  createdById Int
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  photos Photo[]
}

model Photo {
  id           Int      @id @default(autoincrement())
  albumId      Int
  album        Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  fileId       Int      @unique
  file         File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([albumId])
}

// ───────────────────────── 지식 공유회 ─────────────────────────

model Semester {
  id        Int        @id @default(autoincrement())
  /// 예: "2026-2"
  name      String     @unique
  createdAt DateTime   @default(now())
  materials Material[]
}

model Material {
  id          Int      @id @default(autoincrement())
  semesterId  Int
  semester    Semester @relation(fields: [semesterId], references: [id])
  title       String
  content     String   @db.Text
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files File[]
  links Link[]

  @@index([semesterId])
}

// ───────────────────────── 파일 / 링크 (공통) ─────────────────────────

/// 모든 업로드 파일. 소속은 nullable FK 또는 역참조(Presentation, Photo, User.photoFile)로 표현
model File {
  id           Int      @id @default(autoincrement())
  originalName String   @db.VarChar(255)
  /// 디스크에 저장된 파일명 (UUID + 확장자)
  storedName   String   @unique
  mimeType     String
  size         Int
  uploadedById Int
  uploadedBy   User     @relation("FileUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  archiveId  Int?
  archive    Archive?  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  materialId Int?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)

  presentation Presentation?
  photo        Photo?
  userPhoto    User?         @relation("UserPhoto")

  @@index([archiveId])
  @@index([materialId])
}

model Link {
  id          Int      @id @default(autoincrement())
  url         String   @db.VarChar(2000)
  title       String?
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  archiveId  Int?
  archive    Archive?  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  materialId Int?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([archiveId])
  @@index([materialId])
}
